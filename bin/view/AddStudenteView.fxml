<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="269.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="control.AddStudenteController">

	<children>
		<!-- Contenitore principale -->
		<HBox spacing="30.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">

			<!-- Colonna sinistra: form -->
			<VBox prefWidth="260.0" spacing="8.0">
				<children>
					<Label text="Nome" />
					<TextField fx:id="txtNome" promptText="Inserisci nome" />

					<Label text="Cognome" />
					<TextField fx:id="txtCognome" promptText="Inserisci cognome" />

					<HBox spacing="10.0">
						<padding>
							<Insets bottom="0.0" left="0.0" right="0.0" top="10.0" />
						</padding>
						<children>
							<Button defaultButton="true" mnemonicParsing="false" onAction="#onSave" text="Salva" />
							<Button cancelButton="true" mnemonicParsing="false" onAction="#onChiudi" text="Chiudi" />
						</children>
					</HBox>
				</children>
			</VBox>

			<!-- Colonna destra: attività -->
			<VBox prefWidth="260.0" spacing="10.0">
				<children>
					<Label text="Seleziona attività:" />

					<ScrollPane fitToWidth="true" prefHeight="173.0" prefWidth="260.0">
						<content>
							<!-- QUI inserirai dinamicamente le CheckBox -->
							<VBox fx:id="boxAttivita" spacing="6.0">
								<padding>
									<Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
								</padding>
							</VBox>
						</content>
					</ScrollPane>
				</children>
			</VBox>

		</HBox>
	</children>
</AnchorPane>
